<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
    </php>

    <testsuites>
        <testsuite name="appli.catalog">
            <directory>tests/Application/Unit/Catalog/UseCase</directory>
        </testsuite>
        <testsuite name="appli.customer">
            <directory>tests/Application/Unit/Customer/UseCase</directory>
        </testsuite>
        <testsuite name="appli.ordering">
            <directory>tests/Application/Unit/Ordering</directory>
        </testsuite>
        <testsuite name="appli.shared">
            <directory>tests/Application/Unit/Shared</directory>
        </testsuite>

        <testsuite name="domain.catalog">
            <directory>tests/Domain/Catalog/Unit</directory>
        </testsuite>
        <testsuite name="domain.customer">
            <directory>tests/Domain/Customer/Unit</directory>
        </testsuite>
        <testsuite name="domain.ordering">
            <directory>tests/Domain/Ordering/Unit</directory>
        </testsuite>
        <testsuite name="domain.shared">
            <directory>tests/Domain/SharedKernel/Unit</directory>
        </testsuite>

        <testsuite name="infra.adapter.catalog">
            <directory>tests/Infrastructure/Unit/Adapter/Catalog</directory>
        </testsuite>
        <testsuite name="infra.adapter.cache">
            <directory>tests/Infrastructure/Unit/Adapter/Cache</directory>
        </testsuite>
        <testsuite name="infra.api-platform.encoder">
            <directory>tests/Infrastructure/Unit/ApiPlatform/Encoder</directory>
        </testsuite>
        <testsuite name="infra.api-platform.serializer">
            <directory>tests/Infrastructure/Unit/ApiPlatform/Serializer</directory>
        </testsuite>
        <testsuite name="infra.persist">
            <directory>tests/Infrastructure/Integration/Persistence</directory>
        </testsuite>
        <testsuite name="infra.symfony.command">
            <directory>tests/Infrastructure/Unit/Symfony/Command</directory>
        </testsuite>
        <testsuite name="infra.symfony.messenger">
            <directory>tests/Infrastructure/Unit/Symfony/Messenger</directory>
        </testsuite>
        <testsuite name="infra.symfony.security">
            <directory>tests/Infrastructure/Unit/Symfony/Security</directory>
        </testsuite>

        <testsuite name="pres.state.catalog">
            <directory>tests/Presentation/Unit/State/Catalog</directory>
        </testsuite>
        <testsuite name="pres.state.customer">
            <directory>tests/Presentation/Unit/State/Customer</directory>
        </testsuite>
        <testsuite name="pres.state.ordering">
            <directory>tests/Presentation/Unit/State/Ordering</directory>
        </testsuite>
        <testsuite name="pres.state.shared">
            <directory>tests/Presentation/Unit/State/Shared</directory>
        </testsuite>

        <testsuite name="api.catalog.category">
            <file>tests/Presentation/Api/Catalog/CategoryTest.php</file>
        </testsuite>
        <testsuite name="api.catalog.product">
            <file>tests/Presentation/Api/Catalog/ProductTest.php</file>
        </testsuite>
        <testsuite name="api.customer.customer">
            <file>tests/Presentation/Api/Customer/CustomerTest.php</file>
        </testsuite>
        <testsuite name="api.customer.address">
            <file>tests/Presentation/Api/Customer/AddressTest.php</file>
        </testsuite>
        <testsuite name="api.order.cart">
            <file>tests/Presentation/Api/Ordering/CartTest.php</file>
        </testsuite>
        <testsuite name="api.health">
            <file>tests/Presentation/Api/Shared/HealthTest.php</file>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <!-- Peuplement local uniquement, enregistre sous `when@dev`. -->
            <directory>src/Infrastructure/Symfony/DataFixtures</directory>
            <file>src/Kernel.php</file>
        </exclude>

        <!-- Sans ces declarations, une deprecation emise par l'ODM est imputee a
             doctrine/deprecations plutot qu'a notre appelant. -->
        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>
</phpunit>
