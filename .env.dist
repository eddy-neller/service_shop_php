# Copy this file to .env for local development. Never commit the resulting .env.

###> Application ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-in-your-local-env
APP_SHARE_DIR=var/share
APP_TITLE="E.N Shop Service Shop"
APP_VERSION=1.0.0
PRODUCT_IMAGE_MAX_SIZE=10485760
PRODUCT_IMAGE_MIN_DIMENSION=200
PRODUCT_IMAGE_MAX_DIMENSION=2000
###< Application ###

###> Routing ###
# URLs used when generating links outside an HTTP request.
DEFAULT_URI=http://localhost
###< Routing ###

###> MongoDB 8 ###
# Host/port as seen from the app container. *_EXPOSED_PORT is the port published on the host.
# `replicaSet=rs0` is required for multi-document transactions.
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_EXPOSED_PORT=
MONGODB_DB=service_shop
MONGODB_USERNAME=root
MONGODB_PASSWORD=
MONGODB_URL="mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DB}?authSource=admin&replicaSet=rs0"
###< MongoDB 8 ###

###> Redis 8 ###
# Cache applicatif partage entre les replicas de service_shop. Donnees recomputables seulement.
REDIS_EXPOSED_PORT=20913
REDIS_URL="redis://redis:6379"
###< Redis 8 ###

###> JWT / Authentication ###
# VALIDATION UNIQUEMENT. Ce service ne detient que la cle publique du service
# emetteur : il verifie les signatures, il n'en produit aucune.
# Copier depuis api/config/jwt/public.pem — ne JAMAIS copier private.pem ici.
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
###< JWT / Authentication ###

###> CORS ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< CORS ###

###> Messenger ###
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_EXPOSED_PORT=20918
RABBITMQ_MANAGEMENT_EXPOSED_PORT=20919
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=en_shop_shop
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}/messages"
###< Messenger ###

###> Bus inter-services (SNS/SQS) ###
# Evenements d'integration publies par service_identity. En developpement, la brique `aws_local`
# emule SNS et SQS (LocalStack) ; l'alias `aws-local` n'est resolu que depuis le reseau
# `en_shop_php_bus`, que seul le `worker` rejoint. Brique eteinte, ce service demarre et repond
# quand meme — seul son worker `user_events` echoue a joindre la file.
#
# En production, le DSN vise AWS et ne porte **aucune cle** : la chaine d'identifiants par defaut
# d'AsyncAws prend le relais (EKS Pod Identity), et viser l'hote reel
# `sqs://sqs.${AWS_REGION}.amazonaws.com/<compte>/shop-user-events?auto_setup=false` evite meme
# l'appel `GetQueueUrl`, donc un droit IAM de moins.
AWS_REGION=eu-west-3
AWS_ENDPOINT=aws-local:4566
USER_EVENTS_QUEUE=shop-user-events
USER_EVENTS_TRANSPORT_DSN="sqs://${AWS_ENDPOINT}/${USER_EVENTS_QUEUE}?sslmode=disable&auto_setup=false&region=${AWS_REGION}&access_key=test&secret_key=test"
###< Bus inter-services (SNS/SQS) ###

###> Varnish 8 ###
# URL Compose interne utilisee par API Platform pour envoyer les BAN apres un commit catalogue.
# Varnish n'a pas de port publie en dev ; il devient l'entree `service-shop` en production.
VARNISH_URL="http://varnish"
###< Varnish 8 ###

###> Nginx ###
# Developpement seulement : localhost:20910 et Kong pointent directement vers nginx pour que le
# profiler Symfony decrive la requete courante. En production, Varnish porte `service-shop`.
NGINX_EXPOSED_PORT=20910
###< Nginx ###

###> Lock ###
# Pourquoi Redis et jamais `flock` : docs/lock.md
LOCK_DSN="${REDIS_URL}/1"
###< Lock ###

###> Xdebug ###
# Set XDEBUG_MODE=off to disable the debugger and get the performance back.
XDEBUG_MODE=off
###< Xdebug  ###

###> stripe/stripe-php ###
# Placeholders only. Put real local keys in .env.
STRIPE_SHOP_SECRET_KEY=sk_test_placeholder
TEST_STRIPE_SHOP_SECRET_KEY=sk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
###< stripe/stripe-php ###
