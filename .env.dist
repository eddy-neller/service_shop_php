###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-in-your-local-env
###< symfony/framework-bundle ###

###> JWT / Authentication ###
# VALIDATION UNIQUEMENT. Ce service ne detient que la cle publique du service
# emetteur : il verifie les signatures, il n'en produit aucune.
# Copier depuis api/config/jwt/public.pem — ne JAMAIS copier private.pem ici.
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
###< JWT / Authentication ###

###> docker ###
# Le monolithe occupe 20900-20909. Ce service demarre a 20910.
NGINX_EXPOSED_PORT=20910
###< docker ###
