# Non-sensitive defaults for the isolated test environment.
KERNEL_CLASS='App\Kernel'
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test-secret
PRODUCT_IMAGE_MAX_SIZE=10485760
PRODUCT_IMAGE_MIN_DIMENSION=200
PRODUCT_IMAGE_MAX_DIMENSION=2000

# Paire dediee aux tests. La cle privee n'existe que pour fabriquer les tokens
# des scenarios ; elle n'a aucun rapport avec celle du service emetteur.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
JWT_PASSPHRASE=

# Base dediee a la suite : les tests fonctionnels ecrivent dans un vrai MongoDB,
# jamais dans celui du developpement.
MONGODB_DB=service_shop_test
MONGODB_URL="mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DB}?authSource=admin&replicaSet=rs0"
